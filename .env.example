# Saarthi Travel Unfolded - configuration
# Copy to .env and adjust. Never commit real secrets. Every variable is optional
# unless marked REQUIRED IN PRODUCTION.

# Database (PostgreSQL 17 + PostGIS)
# Image used by docker compose. On Apple Silicon, imresamu/postgis:17-3.5 is a
# multi-arch build of the same image and avoids x86 emulation.
POSTGIS_IMAGE=imresamu/postgis:17-3.5
POSTGRES_DB=destination_intel
POSTGRES_USER=idi
# REQUIRED IN PRODUCTION: use a strong password.
POSTGRES_PASSWORD=idi_local_dev
# Host port for the database (5433 avoids clashing with a local PostgreSQL).
DB_PORT=5433

# When running the API outside Docker (mvn spring-boot:run), it reads these:
DATABASE_URL=jdbc:postgresql://localhost:5433/destination_intel
DATABASE_USERNAME=idi
DATABASE_PASSWORD=idi_local_dev
DATABASE_POOL_SIZE=10

# Public URL
# REQUIRED IN PRODUCTION: the URL readers use. Sign-in links and OAuth redirect
# URIs are built from it.
APP_PUBLIC_URL=http://localhost:3000
WEB_PORT=3000
# Set to true when serving over HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=false
# Only true when the API is reachable exclusively through a trusted proxy that
# appends X-Forwarded-For (docker compose sets this for the api container).
TRUST_FORWARDED_HEADERS=false
# Frontend: forward the client address from X-Forwarded-For only when deployed behind a load balancer
# that appends it (Render, a cloud load balancer, nginx with proxy_add_x_forwarded_for). Without one,
# a client could choose its own address and dodge rate limits.
TRUST_PROXY_HEADERS=false

#  Administrators
# Comma-separated, lowercase. A user who signs in with a verified email listed here
# becomes an administrator (ingestion operations, steward appointments).
APP_ADMIN_EMAILS=admin@example.test

# Email sign-in (SMTP)
# docker compose runs Mailpit, a local mail catcher (UI at http://localhost:8025).
# For production use your mail provider's SMTP settings. If SMTP_HOST is empty,
# email sign-in is reported as unavailable in the UI.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM="Saarthi Travel Unfolded <no-reply@localhost>"
# Sends "your guide is ready" emails to readers who asked for them. Set false on a laptop that points at the
# production database, so only the live site sends (and erases) readers' addresses.
REQUEST_NOTIFICATIONS_ENABLED=true
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# Optional OAuth sign-in
# Leave empty to disable. Redirect URI to register with the provider:
#   ${APP_PUBLIC_URL}/login/oauth2/code/google   (or .../github)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

#  Ingestion
INGESTION_ENABLED=true
# On first start, ingest the launch guides and build the nationwide index.
INGESTION_BOOTSTRAP=true
# Wikidata ids of launch destinations (Q10086 = Mysuru, Q1355 = Bengaluru).
INGESTION_SEED_GUIDES=Q10086,Q1355
# Additional Wikivoyage destinations to ingest per day (largest first). 0 = only
# seeds, reader requests and admin-triggered jobs.
INGESTION_EXPANSION_PER_DAY=0
# Contact appended to the User-Agent sent to Wikimedia and Open-Meteo, as their
# API etiquette asks (a URL or email address for the operator of this instance).
INGESTION_CONTACT=
# Job types this instance runs (comma-separated; empty = all). On a small web server such as Render's 512 MB
# plan, run only the light per-destination jobs and leave the multi-GB map imports to a bigger machine:
# INGESTION_JOB_TYPES=wikivoyage_guide,climate,place_image,resolve_request,coverage_refresh,quality_evaluation,match_resolution,ai_review
INGESTION_JOB_TYPES=

# AI review of imported listings (optional, Google Gemini). The model only flags doubtful listings for an admin
# (Operations page); it never writes or changes guide content. Free-tier keys: https://aistudio.google.com/apikey
# When enabled, also add ai_review to INGESTION_JOB_TYPES if you set that list.
AI_REVIEW_ENABLED=false
GEMINI_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
# Requests per day (UTC). Stay under your free-tier quota; reviews pause for the day when it is reached.
AI_DAILY_REQUEST_BUDGET=200

# Frontend
# Where the Next.js server reaches the API (server-side rendering and the /api proxy).
BACKEND_INTERNAL_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Tests
# PostGIS image used by Testcontainers in backend tests.
TEST_POSTGIS_IMAGE=imresamu/postgis:17-3.5